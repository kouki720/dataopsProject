
# ==========================================
# PROJECT CONFIGURATION
# ==========================================

PROJECT_NAME=dataops-energy
ENVIRONMENT=dev
LOG_LEVEL=INFO

# ==========================================
# ECO2MIX API
# ==========================================

ECO2MIX_DATASET_ID=eco2mix-national-cons-def

ECO2MIX_API_BASE_URL=https://odre.opendatasoft.com/api/explore/v2.1/catalog/datasets

ECO2MIX_API_LIMIT=100

# ==========================================
# OPEN-METEO API
# ==========================================

OPEN_METEO_BASE_URL=https://archive-api.open-meteo.com/v1/archive

OPEN_METEO_TIMEZONE=Europe/Paris

# ==========================================
# DUCKDB CONFIGURATION
# ==========================================

DUCKDB_DEV_PATH=warehouse/dev/dev.duckdb

DUCKDB_PROD_PATH=warehouse/prod/prod.duckdb

DUCKDB_THREADS=4

# ==========================================
# DATA CONFIGURATION
# ==========================================

DATA_RAW_PATH=data/raw

DATA_STAGING_PATH=data/staging

DATA_PROCESSED_PATH=data/processed
